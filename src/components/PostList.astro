---
import Link from "@components/Link.astro";
import type { HTMLTag } from "astro/types";
import type { CollectionEntry } from "astro:content";
import Date from "@components/Date.astro";

interface Props {
  posts: CollectionEntry<"posts">[];
  heading: HTMLTag;
}

const { posts, heading: Heading } = Astro.props;
---

<ul class="flex list-disc flex-col gap-6 pt-8 pb-6 pl-4">
  {
    posts.map(({ id, data: { title, description, date_published } }) => (
      <li>
        <div class="xs:flex-row xs:items-center mb-2 flex flex-col justify-between">
          <Heading class="leading-tight">
            <Link href={`/posts/${id}`}>{title}</Link>
          </Heading>
          <Date date={date_published} class="text-sm italic sm:text-lg" />
        </div>
        <p class="text-sm tracking-wide text-zinc-600 sm:text-lg dark:text-zinc-300">
          {description}
        </p>
      </li>
    ))
  }
</ul>
