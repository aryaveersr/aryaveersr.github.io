---
import { cn } from "@utils/cn";
import type { HTMLAttributes } from "astro/types";
import Date from "@components/Date.astro";

interface Props extends HTMLAttributes<"div"> {
  items: { key: string; value: string | Date }[];
}

const { items, class: classNames, ...rest } = Astro.props;
---

<div class={cn("grid grid-cols-[auto_auto] gap-x-4", classNames)} {...rest}>
  {
    items.map(({ key, value }) => (
      <div class="contents">
        <span class="text-zinc-500">{key}</span>
        {typeof value == "string" ? (
          <span>{value}</span>
        ) : (
          <Date date={value} />
        )}
      </div>
    ))
  }
</div>
