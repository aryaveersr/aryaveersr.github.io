---
import Link from "@components/Link.astro";
import type { HTMLTag } from "astro/types";
import type { CollectionEntry } from "astro:content";

interface Props {
  projects: CollectionEntry<"projects">[];
  heading: HTMLTag;
}

const { projects, heading: Heading } = Astro.props;
---

<ul class="flex list-disc flex-col gap-6 pt-8 pb-6 pl-4">
  {
    projects.map(({ data: { name, description, links } }) => (
      <li>
        <div class="xs:flex-row xs:items-center mb-2 flex flex-col justify-between">
          <Heading class="leading-tight">
            <Link href={links["github"]} class="text-zinc-800">
              {name}
            </Link>
          </Heading>
          <div class="flex items-center gap-3 text-lg">
            {Object.entries(links)
              .filter(([title, href]) => title != "github")
              .map(([title, href], index) => (
                <Fragment>
                  <Link {href} class="gap-px">
                    {title}
                  </Link>
                  {index < Object.entries(links).length - 2 && (
                    <span class="text-zinc-500">•</span>
                  )}
                </Fragment>
              ))}
          </div>
        </div>
        <p class="text-lg tracking-wide text-zinc-600 dark:text-zinc-300">
          {description}
        </p>
      </li>
    ))
  }
</ul>
