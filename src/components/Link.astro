---
import type { HTMLAttributes } from "astro/types";
import { Icon } from "astro-icon/components";

interface Props extends HTMLAttributes<"a"> {
  icon?: boolean;
}

const { icon = true, class: classNames, ...rest } = Astro.props;
---

<a
  {...rest}
  class:list={[
    "font-medium text-zinc-500 decoration-current hover:text-zinc-950 hover:underline dark:text-zinc-400 dark:hover:text-zinc-50",
    icon && "inline-flex items-baseline",
    classNames,
  ]}
>
  <slot />
  {
    icon && (
      <span class="self-center">
        <slot name="icon">
          <Icon name="mdi:arrow-top-right" />
        </slot>
      </span>
    )
  }
</a>
