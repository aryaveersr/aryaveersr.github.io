---
import type { HTMLAttributes } from "astro/types";
import { Icon } from "astro-icon/components";
import { cn } from "@utils/cn";

interface Props extends HTMLAttributes<"a"> {
  icon?: boolean;
}

const { icon = true, class: classNames, ...rest } = Astro.props;
---

<a
  {...rest}
  class={cn(
    "font-medium underline decoration-current hover:text-zinc-600 dark:hover:text-zinc-400",
    icon && "inline-flex items-baseline",
    classNames,
  )}
>
  <slot />
  {
    icon && (
      <span class="self-center">
        <slot name="icon">
          <Icon name="mdi:arrow-top-right" />
        </slot>
      </span>
    )
  }
</a>
