---
import Layout from "@layouts/Layout.astro";
import { stringifyDate } from "@utils/posts";
import type { GetStaticPaths } from "astro";
import { getCollection, render } from "astro:content";

export const getStaticPaths = (async () => {
  const posts = await getCollection("posts");

  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout>
  <section class="pt-8 pb-24">
    <h1 id={post.id} class="text-4xl font-bold">
      {post.data.title}
    </h1>
    <time
      datetime={stringifyDate(post.data.date_published)}
      class="my-2 block text-sm text-zinc-500 italic sm:text-lg"
    >
      {stringifyDate(post.data.date_published)}
    </time>
    <p>{post.data.description}</p>
  </section>
  <article
    class="prose prose-zinc prose-base sm:prose-xl prose-p:leading-relaxed dark:prose-invert prose-li:my-0 prose-ul:my-0"
  >
    <Content />
  </article>
</Layout>
