---
import Layout from "@layouts/Layout.astro";
import MetadataView from "@components/MetadataView.astro";
import type { GetStaticPaths } from "astro";
import { getCollection, render } from "astro:content";

export const getStaticPaths = (async () => {
  const posts = await getCollection("posts");

  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout>
  <section class="pt-8 pb-16">
    <h1 id={post.id} class="text-4xl font-bold">
      {post.data.title}
    </h1>

    <MetadataView
      items={[
        { key: "Posted", value: post.data.date_published },
        ...(post.data.date_updated
          ? [{ key: "Last Updated", value: post.data.date_updated }]
          : []),
      ]}
      class="my-4 w-fit"
    />

    <p>{post.data.description}</p>
  </section>
  <article
    class="prose prose-zinc prose-base sm:prose-xl prose-p:leading-relaxed dark:prose-invert prose-li:my-0 prose-ul:my-0"
  >
    <Content />
  </article>
</Layout>
