---
import Layout from "@layouts/Layout.astro";
import { getCollection } from "astro:content";
import ProjectList from "@components/ProjectList.astro";

const projects = await getCollection("projects");
---

<Layout>
  <Fragment slot="head">
    <title>Projects</title>
    <meta name="description" content="Projects I've worked on." />
  </Fragment>

  <h1 id="projects">
    <a
      href="#projects"
      class="mb-4 block w-fit border-b-2 font-sans text-sm font-bold text-zinc-950 dark:text-zinc-50"
    >
      PROJECTS
    </a>
  </h1>
  <p>
    Here are some of the projects I've worked on in no particular order. I have
    a habit of abandoning projects though, so these are the ones that pass a
    bare minimum threshold.
  </p>
  <ProjectList {projects} heading="h2" />
</Layout>
