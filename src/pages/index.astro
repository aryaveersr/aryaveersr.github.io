---
import Layout from "@layouts/Layout.astro";
import Link from "@components/Link.astro";
import { getCollection } from "astro:content";
import ProjectList from "@components/ProjectList.astro";
import PostList from "@components/PostList.astro";

const projects = await getCollection("projects");
const posts = await getCollection("posts");
---

<Layout class="flex flex-col gap-12">
  <Fragment slot="head">
    <title>AryaveerSR</title>
    <meta
      name="description"
      content="I am an aspiring software developer from India. This is my corner on the internet where I write about stuff."
    />
  </Fragment>

  <h1 class="-mb-4">Hi, I'm Aryaveer!</h1>
  <section>
    <h2 id="about">
      <a
        href="#about"
        class="mb-4 block w-fit border-b-2 font-sans text-sm font-bold text-zinc-950 dark:text-zinc-50"
      >
        ABOUT
      </a>
    </h2>
    <p>
      I am an aspiring software developer from India. This is my corner on the
      internet where I (hope to) write stuff that might one day be useful to
      someone. You can find most of my projects on {" "}
      <Link href="https://github.com/aryaveersr">GitHub</Link>. You can also
      reach me at {" "}
      <Link href="mailto:aryaveersr@">me.aryaveer@gmail.com</Link>
    </p>
  </section>
  <section>
    <h2 id="projects">
      <a
        href="#projects"
        class="mb-4 block w-fit border-b-2 font-sans text-sm font-bold text-zinc-950 dark:text-zinc-50"
      >
        PROJECTS
      </a>
    </h2>
    <p>
      Here are some of the projects I've worked on in no particular order. A
      (more) complete list {" "}
      <Link href="/projects">can be found here.</Link>
    </p>
    <ProjectList projects={projects.filter((p) => p.data.pin)} heading="h3" />
    <Link href="/projects" class="text-sm sm:text-lg">View all projects</Link>
  </section>
  <section>
    <h2 id="posts">
      <a
        href="#posts"
        class="mb-4 block w-fit border-b-2 font-sans text-sm font-bold text-zinc-950 dark:text-zinc-50"
      >
        POSTS
      </a>
    </h2>
    <p>
      Here I (plan to) write about various topics I find interesting. These are
      my most recent yappings. A (more) complete list {" "}
      <Link href="/projects">can be found here.</Link>
    </p>
    <PostList {posts} heading="h3" />
    <Link href="/posts" class="text-sm sm:text-lg">View all posts</Link>
  </section>
</Layout>
