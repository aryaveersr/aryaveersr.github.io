---
import Layout from "@layouts/Layout.astro";
import { getCollection } from "astro:content";
import PostList from "@components/PostList.astro";

const posts = await getCollection("posts");
---

<Layout>
  <h1 id="blog">
    <a
      href="#blog"
      class="mb-4 block w-fit border-b-2 font-sans text-sm font-bold text-zinc-950 dark:text-zinc-50"
    >
      BLOG
    </a>
  </h1>
  <p>Here are my yappings on various topics which you may find interesting.</p>
  <PostList {posts} heading="h2" />
</Layout>
