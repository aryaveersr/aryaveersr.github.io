---
import Layout from "@layouts/Layout.astro";
import { getCollection } from "astro:content";
import PostList from "@components/PostList.astro";

const posts = await getCollection("posts");
---

<Layout>
  <Fragment slot="head">
    <title>Posts</title>
    <meta
      name="description"
      content="My yappings on various topics which you may find interesting."
    />
  </Fragment>

  <h1 id="posts">
    <a
      href="#posts"
      class="mb-4 block w-fit border-b-2 font-sans text-sm font-bold text-zinc-950 dark:text-zinc-50"
    >
      POSTS
    </a>
  </h1>
  <p>Here are my yappings on various topics which you may find interesting.</p>
  <PostList {posts} heading="h2" />
</Layout>
